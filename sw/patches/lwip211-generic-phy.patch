+/* antminer-s9: PHY, неизвестный драйверу (на S9 — не Marvell/TI/Realtek).
+ * Скорость определяется только по стандартным регистрам IEEE 802.3:
+ * 4/5 (10/100), 9/10 (1000BASE-T). Задержки RGMII не трогаем:
+ * их задают страпы PHY (в Linux/U-Boot S9 — rgmii-id и generic PHY). */
+static u32_t get_generic_phy_speed(XEmacPs *xemacpsp, u32_t phy_addr)
+{
+	u16_t id1, id2, ctrl, status, adv, lpa, ctrl1000, stat1000;
+	u32_t timeout = 0;
+
+	XEmacPs_PhyRead(xemacpsp, phy_addr, PHY_IDENTIFIER_1_REG, &id1);
+	XEmacPs_PhyRead(xemacpsp, phy_addr, PHY_IDENTIFIER_2_REG, &id2);
+	xil_printf("Generic PHY %04x:%04x at %d, start autonegotiation\r\n",
+			   id1, id2, phy_addr);
+
+	XEmacPs_PhyRead(xemacpsp, phy_addr, 4, &adv);
+	adv |= 0x0C00 | 0x01E0;			/* pause + 10/100 HD/FD */
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, 4, adv);
+	XEmacPs_PhyRead(xemacpsp, phy_addr, 9, &ctrl1000);
+	ctrl1000 |= 0x0200;				/* 1000BASE-T FD */
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, 9, ctrl1000);
+	XEmacPs_PhyRead(xemacpsp, phy_addr, 0, &ctrl);
+	ctrl |= 0x1000 | 0x0200;		/* AN enable + restart */
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, 0, ctrl);
+
+	for (;;) {
+		sleep(1);
+		/* бит link — latch-low: читаем дважды */
+		XEmacPs_PhyRead(xemacpsp, phy_addr, 1, &status);
+		XEmacPs_PhyRead(xemacpsp, phy_addr, 1, &status);
+		if ((status & 0x0020) && (status & 0x0004))
+			break;
+		if (++timeout == 30) {
+			xil_printf("Generic PHY: no link / autonegotiation timeout\r\n");
+			return XST_FAILURE;
+		}
+	}
+
+	XEmacPs_PhyRead(xemacpsp, phy_addr, 10, &stat1000);
+	XEmacPs_PhyRead(xemacpsp, phy_addr, 5, &lpa);
+	xil_printf("Generic PHY: adv %04x lpa %04x 1000ctl %04x 1000stat %04x\r\n",
+			   adv, lpa, ctrl1000, stat1000);
+	if ((ctrl1000 & 0x0200) && (stat1000 & 0x0800))
+		return 1000;
+	if ((adv & lpa) & 0x0180)
+		return 100;
+	return 10;
+}
+
 static u32_t get_IEEE_phy_speed(XEmacPs *xemacpsp, u32_t phy_addr)
 {
 	u16_t phy_identity;
@@ -687,8 +735,10 @@
